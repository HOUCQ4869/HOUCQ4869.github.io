---
import config from "@/config";

const { comments } = config.features;
const { repo, repoId, category, categoryId } = comments;
const enabled =
  comments.enabled && repo !== "" && repoId !== "" && categoryId !== "";
---

{
  enabled && (
    <>
      <section
        id="comments"
        class="app-prose max-w-app my-8 mt-8 w-full border-t border-dashed pt-8"
        aria-label="评论"
      />

      <script
        is:inline
        data-astro-rerun
        define:vars={{
          giscusConfig: { repo, repoId, category, categoryId },
        }}
      >
        const theme = document.documentElement.getAttribute("data-theme") ===
        "dark" ? "dark" : "light"; const s = document.createElement("script");
        s.src = "https://giscus.app/client.js"; s.async = true; s.crossOrigin =
        "anonymous"; s.dataset.repo = giscusConfig.repo; s.dataset.repoId =
        giscusConfig.repoId; s.dataset.category = giscusConfig.category;
        s.dataset.categoryId = giscusConfig.categoryId; s.dataset.mapping =
        "pathname"; s.dataset.strict = "1"; s.dataset.reactionsEnabled = "1";
        s.dataset.emitMetadata = "0"; s.dataset.inputPosition = "top";
        s.dataset.theme = theme; s.dataset.lang = "zh-CN"; s.dataset.loading =
        "lazy"; document.getElementById("comments").appendChild(s);
      </script>

      <script>import "@/scripts/giscusTheme";</script>
    </>
  )
}
