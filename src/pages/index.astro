---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezonePlugin from "dayjs/plugin/timezone";
import "lxgw-wenkai-webfont/lxgwwenkai-regular.css";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezonePlugin);

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const latestPost = featuredPosts[0] ?? sortedPosts[0];
const restPosts = latestPost
  ? sortedPosts.filter((post) => post.id !== latestPost.id)
  : sortedPosts;
const homePath = getRelativeLocaleUrl(locale, "");

const featuredDate = latestPost
  ? dayjs(latestPost.data.pubDatetime)
      .tz(config.site.timezone)
      .format("YYYY-MM-DD")
  : "";
const featuredUrl = latestPost
  ? getPostUrl(latestPost.id, latestPost.filePath, locale)
  : "";
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-10 pb-8">
      <div class="flex items-center justify-between gap-4">
        <h1
          class="font-verse text-2xl leading-relaxed font-normal sm:text-3xl sm:leading-relaxed"
        >
          愿醒来还未破晓，再偷得浮生半宵，如此便好
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-block shrink-0"
          aria-label="RSS Feed"
          title="RSS 订阅"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS 订阅</span>
        </a>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-6">
            <Socials />
          </div>
        )
      }
    </section>

    {
      latestPost && (
        <a
          href={featuredUrl}
          class="group bg-muted/70 border-border hover:border-accent/50 mt-10 mb-2 block rounded-xl border p-6 transition-colors sm:p-8"
        >
          <p class="text-accent font-mono text-xs font-medium tracking-[0.2em] uppercase">
            LATEST · {featuredDate}
          </p>
          <h2 class="group-hover:text-accent mt-3 text-2xl font-bold tracking-tight transition-colors sm:text-3xl">
            {latestPost.data.title}
          </h2>
          <p class="text-muted-foreground mt-2">
            {latestPost.data.description}
          </p>
          <p class="text-muted-foreground group-hover:text-accent mt-5 font-mono text-xs transition-colors">
            阅读全文 →
          </p>
        </a>
      )
    }

    {
      restPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {restPosts.slice(0, postsConfig.perIndex).map((data) => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
